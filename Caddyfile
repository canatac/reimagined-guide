mail.misfits.ai {
    # Handle CORS preflight at Caddy level
    @cors_preflight {
        method OPTIONS
        path /api/*
    }
    header @cors_preflight Access-Control-Allow-Origin "https://mail.misfits.ai"
    header @cors_preflight Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header @cors_preflight Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With"
    header @cors_preflight Access-Control-Allow-Credentials "true"
    header @cors_preflight Access-Control-Max-Age "3600"
    respond @cors_preflight 204

    # Sensitive APIs: route through Next.js for auth middleware enforcement
    reverse_proxy /api/hermes localhost:3001
    reverse_proxy /api/hermes/* localhost:3001
    reverse_proxy /api/admin localhost:3001
    reverse_proxy /api/admin/* localhost:3001
    reverse_proxy /api/external-accounts localhost:3001
    reverse_proxy /api/external-accounts/* localhost:3001
    reverse_proxy /api/emails/*/attachments/* localhost:3001

    # /api/compose/* — must go through Next.js for Edge auth middleware (issue #780/#832).
    # Without this, Caddy proxies /api/compose/send directly to email-api:8000,
    # bypassing Next.js session auth enforcement AND hitting a non-existent route
    # (backend only has /api/send, not /api/compose/send).
    reverse_proxy /api/compose localhost:3001
    reverse_proxy /api/compose/* localhost:3001

    # /api/health* — rewrite to backend mongo-health endpoint (issue #930).
    # Docker healthcheck + monitoring need this route; backend exposes
    # /api/monitoring/mongo-health, not /api/health.
    handle /api/health* {
        rewrite * /api/monitoring/mongo-health
        reverse_proxy localhost:8000
    }

    # Public APIs + remaining: direct to backend (strip backend CORS headers, enforce whitelist)
    reverse_proxy /api/* localhost:8000 {
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Credentials
        header_down -Access-Control-Allow-Methods
        header_down -Access-Control-Expose-Headers
        header_down Access-Control-Allow-Origin "https://mail.misfits.ai"
        header_down Access-Control-Allow-Credentials "true"
    }

    # Frontend
    reverse_proxy * localhost:3001
}
