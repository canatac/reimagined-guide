# ============================================================
# env.example — Variables d'environnement du stack mail Rust
# ============================================================
# Copier dans .env pour le développement local :
#   cp env.example .env
# En production, ces variables sont injectées via 1Password
# (vault: hermes, item: scw-hermes-smtp).
# ============================================================

# --- SMTP Server ---
SMTP_TLS_ADDR=0.0.0.0:8465
SMTP_PLAIN_ADDR=0.0.0.0:8025
SMTP_USERNAME=admin
SMTP_PASSWORD=changeme

# --- TLS (dev local uniquement : certificats auto-signes dans ./certs/) ---
# En production, Caddy gere les certs Let's Encrypt via caddy_data volume.
CERT_PATH=localhost.crt
KEY_PATH=localhost.key

# --- MongoDB ---
# Dev local (container Docker) : MONGODB_CLUSTER_URL=mongodb
# Production (MongoDB natif VM) : MONGODB_CLUSTER_URL=<IP_PRIVEE_SCALEWAY>
MONGODB_USERNAME=admin
MONGODB_PASSWORD=changeme
MONGODB_CLUSTER_URL=mongodb
MONGODB_APP_NAME=mailserver
MONGODB_DATABASE=mailserver
# URL complete (utilisee en prod via 1Password) :
# MONGODB_URL=mongodb://admin:changeme@172.16.12.3:27017/mailserver?authSource=admin

# Stockage emails : true = MongoDB, false = fichiers locaux
USE_MONGODB=true

# --- IMAP Server ---
IMAP_SERVER=0.0.0.0:143
IMAP_SERVER_API_PORT=8080

# --- API Server ---
API_SERVER_ADDR=0.0.0.0:8000

# --- Domaine (production) ---
DOMAIN_NAME=misfits.ai

# --- Monitoring (opt-out: set to false/0 to disable) ---
SMTP_MONITORING_ENABLED=true

# --- DKIM ---
DKIM_SERVICE_URL=http://dkim-service:3000/generate-dkim

# --- OAuth GitHub ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH_CALLBACK_BASE_URL=https://mail.misfits.ai
FRONTEND_BASE_URL=https://mail.misfits.ai

# --- Logs ---
RUST_LOG=info
